# ECOGENESIS local configuration
# Setup-ECOGENESIS.bat generates AUTH_SECRET and DATABASE_URL automatically.
# Only enter API keys below when you have registered with the provider.

DATABASE_URL="file:../db/custom.db"
AUTH_SECRET=""

# Optional: OpenAQ ground-station observations (free account/API key).
# Register: https://explore.openaq.org/register
OPENAQ_API_KEY=""

# Optional: CPCB station records through India's data.gov.in API.
# Register: https://data.gov.in/
DATA_GOV_IN_KEY=""

# No key required by the existing integrations: Open-Meteo, NASA POWER and GBIF.
# Copernicus direct Sentinel workflows, Global Forest Watch and NWDP direct APIs
# are NOT connected in this version; adding their keys will not activate them.
